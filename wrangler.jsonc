{
  // Konfiguration for Cloudflare Pages.
  //
  // Bindningen till KV lag tidigare i dashboarden och nadde aldrig funktionerna.
  // Deklarerad har foljer den med varje deploy och kan inte hamna fel.
  //
  // OBS: nar den har filen finns lases bindningar och vanliga miljovariabler HARIFRAN,
  // inte fran dashboarden. Secrets (RESEND_API_KEY) ligger kvar i dashboarden och
  // ska aldrig in i den har filen - den ligger i git.
  "name": "beaps-besiktning",
  "compatibility_date": "2024-11-01",
  "pages_build_output_dir": ".",

  "kv_namespaces": [
    {
      "binding": "SIGNSTORE",
      "id": "dfc4337f75f349bdb97b5c309cde472a"
    }
  ],

  // Bilder och video for galleriet. R2 och inte KV: filerna ar manga och stora, och
  // KV:s skrivtak pa gratisnivan racker inte till ett hus med flera hundra bilder.
  // Kraver att en R2-bucket med exakt det har namnet finns - se CLOUDFLARE.md.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "beaps-media"
    }
  ],

  "vars": {
    "MAIL_FROM": "Beaps Besiktning <besiktning@bedoma.se>",
    // Every report the app mails to Beaps (move-in/out, new property, shortstay, signed copies)
    // goes to Mike (Erik, 2026-10-09). Remove this line to go back to longstay@ and guestservice@.
    "MAIL_TO": "michal@beaps.se",
    // Replies to any mail the app sends - the signing link, the reminder, the signed report -
    // land here instead of bouncing off the send-only sender address.
    "MAIL_REPLY_TO": "longstay@beaps.se"
  },

  // Preview deployments (any branch that is not main) get the same bindings and variables, so
  // a branch can be tried at <branch>.beaps-besiktning.pages.dev with everything working. The
  // secrets (RESEND_API_KEY, APP_PASSWORD) are set for Preview separately in the dashboard.
  // Note that the KV namespace and the R2 bucket are the production ones: a test run on a
  // preview writes real records, under tokens of its own.
  "env": {
    "preview": {
      "kv_namespaces": [
        { "binding": "SIGNSTORE", "id": "dfc4337f75f349bdb97b5c309cde472a" }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "beaps-media" }
      ],
      "vars": {
        "MAIL_FROM": "Beaps Besiktning <besiktning@bedoma.se>",
        "MAIL_TO": "michal@beaps.se",
        "MAIL_REPLY_TO": "longstay@beaps.se",
        // Keeps the preview's login-failure counter apart from production's in the shared KV.
        "ENV": "preview"
      }
    }
  }
}
