{
  // Konfiguration for Cloudflare Pages.
  //
  // Bindningen till KV lag tidigare i dashboarden och nadde aldrig funktionerna.
  // Deklarerad har foljer den med varje deploy och kan inte hamna fel.
  //
  // OBS: nar den har filen finns lases bindningar och vanliga miljovariabler HARIFRAN,
  // inte fran dashboarden. Secrets (RESEND_API_KEY) ligger kvar i dashboarden och
  // ska aldrig in i den har filen - den ligger i git.
  "name": "beaps-besiktning",
  "compatibility_date": "2024-11-01",
  "pages_build_output_dir": ".",

  "kv_namespaces": [
    {
      "binding": "SIGNSTORE",
      "id": "dfc4337f75f349bdb97b5c309cde472a"
    }
  ],

  // Bilder och video for galleriet. R2 och inte KV: filerna ar manga och stora, och
  // KV:s skrivtak pa gratisnivan racker inte till ett hus med flera hundra bilder.
  // Kraver att en R2-bucket med exakt det har namnet finns - se CLOUDFLARE.md.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "beaps-media"
    }
  ],

  "vars": {
    "MAIL_FROM": "Beaps Besiktning <besiktning@bedoma.se>"
  }
}
